{
  "name": "namastays-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "test": "node --conditions=react-server --import tsx --test src/lib/__tests__/gpx.test.ts src/lib/__tests__/images.test.ts src/lib/__tests__/mappers.test.ts src/lib/__tests__/client.test.ts",
    "check:api": "node --conditions=react-server --env-file=.env.local --import tsx scripts/check-api.ts"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "0.522.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.11.18",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^5.54.0",
    "@typescript-eslint/parser": "^5.54.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^8.50.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "postcss": "^8.5.32",
    "tailwindcss": "3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4"
  }
}
